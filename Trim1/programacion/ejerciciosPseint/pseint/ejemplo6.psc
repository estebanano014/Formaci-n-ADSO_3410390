Algoritmo ejemplo6
	//Esteban Quiceno Duque
	//Area ambiente de formacion
	
	//Definicion de variables
	Definir largo Como Real;
	Definir ancho Como Real;
	Definir area Como Real;
	
	//entrada
	Escribir "Ingrese el largo del ambiente";
	Leer largo;
	
	Escribir "Ingrese el ancho del ambiente";
	Leer ancho;
	
	//Proceso
	area <- largo*ancho;
	
	//salida
	Escribir "El area del ambiente es:",area , "m2";
FinAlgoritmo
