Algoritmo ejemplo4
	//solicitar al usuario 3 numeros y mostrar e pantalla el promedio de todos
	//Entrada
	//definicion de variables
	Definir N1 Como Entero;;
	Definir N2 Como Entero;
	Definir N3 Como Entero;
	Definir promedio Como Real;;
	
	Escribir "Ingrese 3 numeros";
	
	Leer N1;
	Leer N2;
	Leer N3;
	
	//proceso
	promedio <- (N1 +  N2 + N3) /3;
	
	Escribir "El promedio de los numeros " ,N1,", ", N2," y ", N3, " es: ", promedio;
FinAlgoritmo
