Algoritmo punto7
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir Num1 Como Real;
    Definir Num2 Como Real; 
    Definir operacion como real;
	
	//Entrada algoritmo 
    Escribir "Digite dos números para sumarlos.";
	Leer Num1;
    Leer Num2;
	
	//Proceso Algoritmo 
    operacion <- Num1+Num2;
	
	//Salida Algoritmo 
    Escribir "El resultado de la suma es: ", operacion;
FinAlgoritmo