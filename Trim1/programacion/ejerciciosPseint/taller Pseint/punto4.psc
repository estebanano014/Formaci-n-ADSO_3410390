Algoritmo punto4
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir NumA Como Entero;
    Definir NumB Como Entero; 
    Definir operacion como Entero;
	
	//Entrada algoritmo 
    Escribir "Digite dos números para realizar la operación (A+B)*2+10";
    Leer NumA;
    Leer NumB;
	
	//Proceso Algoritmo 
    operacion <- (NumA+NumB)*2+10;
	
	//Salida Algoritmo 
    Escribir "El resultado de la operación es: ", operacion;
FinAlgoritmo