Algoritmo punto27
	// Esteban Quiceno Duque 
    
    //Definición de variables 
	Definir num Como entero;
	
	
	//Entrada algoritmo 
	Escribir "Ingrese el número:";  
	Leer num;  
	
	//Salida y proceso
	Si (num % 2 == 0) Entonces  
		Escribir "El numero es par.";  
	Sino  
			Escribir "El numero es impar.";
	FinSi
FinAlgoritmo