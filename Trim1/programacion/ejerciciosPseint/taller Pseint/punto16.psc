Algoritmo punto16
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir ladoX Como Real;
    Definir ladoY Como Real;
    Definir area Como Real;
	
	//Entrada algoritmo 
    Escribir "Ingrese el lado X del rectángulo:";
    Leer ladoX;
	
    Escribir "Ingrese el lado Y del rectángulo:";
    Leer ladoY;
	
	//Proceso Algoritmo 
    area <- ladoX * ladoY;
	
	//Salida Algoritmo 
    Escribir "El área del rectángulo es: ", area;
FinAlgoritmo