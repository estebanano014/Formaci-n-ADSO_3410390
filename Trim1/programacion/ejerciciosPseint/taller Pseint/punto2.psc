Algoritmo punto2
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir NumA Como Real;
    Definir NumB Como Real; 
    Definir operacion como real;
	
	//Entrada algoritmo 
    Escribir "Digite dos números";
	Leer NumA;
    Leer NumB;
	
	//Proceso Algoritmo 
    operacion <- (NumA+NumB)*2;
	
	//Salida Algoritmo 
    Escribir "El doble de la suma de los dos números equivale a: ", operacion;
FinAlgoritmo
