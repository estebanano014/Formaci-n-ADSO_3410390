Algoritmo punto11
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir Num1 Como Entero;
    Definir Num2 Como Entero; 
    Definir operacion como Entero;
	
	//Entrada algoritmo 
    Escribir "Digite dos números para ver su diferencia.";
	Leer Num1;
    Leer Num2;
	
	//Proceso Algoritmo 
    operacion <- Num1-Num2;
	
	//Salida Algoritmo 
    Escribir "La diferencia entre el ",Num1," y ",Num2," es de: ", operacion;
FinAlgoritmo