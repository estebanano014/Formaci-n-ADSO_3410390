Algoritmo punto14
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir radio Como Real;
    Definir longitudCircunferencia como Real;
    Definir valorPI como Real;
	
	//Asignacion variable
    valorPI <- 3.1415926;
	
	//Entrada algoritmo 
    Escribir "Ingrese el radio de la circunferencia:";
    Leer radio;
	
	//Proceso Algoritmo 
    longitudCircunferencia<- 2 * PI * radio;
	
	//Salida Algoritmo 
    Escribir "La longitud de la circunferencia es: ", longitudCircunferencia;
FinAlgoritmo