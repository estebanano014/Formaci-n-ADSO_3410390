Algoritmo punto3
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir promedioSemestre como Real;
    Definir nomEstudiante como cadena;
    Definir cantNotasPerdidas como Entero;
	
	//Entrada algoritmo 
    Escribir "Ingrese el nombre del estudiante, el número de notas que perdió y su promedio del semestre.";
