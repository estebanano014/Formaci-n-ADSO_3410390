Algoritmo punto9
	// Esteban Quiceno Duque 
    
    //Definición de variables 
    Definir nomEstudiante como Cadena;
    Definir cantMateriasPerdidas como entero;
    Definir cantMateriasGanadas como entero;
	
	//Entrada algoritmo 
    Escribir "Ingresa el nombre del estudiante:";
    Leer nomEstudiante;
	
    Escribir "Ingresa la cantidad de materias que perdió el estudiante:";
    Leer cantMateriasPerdidas;
	
    Escribir "Ingresa la cantidad de materias que ganó el estudiante:";
    Leer cantMateriasGanadas;
	
	//Salida Algoritmo 
    Escribir "Señor(a): ", nomEstudiante;
    Escribir "Usted perdió esta cantidad de materias: ", cantMateriasPerdidas;
    Escribir "Usted ganó está cantidad de materias: ", cantMateriasGanadas;
FinAlgoritmo